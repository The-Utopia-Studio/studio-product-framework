# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Clerk JWT issuer for Convex (https://xxx.clerk.accounts.dev) — also used as CLERK_JWT_ISSUER_DOMAIN
CLERK_JWT_ISSUER_DOMAIN=
# Optional alias kept for Convex auth.config compatibility
VITE_CLERK_FRONTEND_API_URL=

# Clerk (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
FRONTEND_URL=http://localhost:3000

# Billing — enable the providers you use
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

AUTUMN_API_KEY=
AUTUMN_SECRET_KEY=

# Inference (prefer OpenRouter for metered vertical)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Runtime agent sandbox (provider-specific)
SANDBOX_API_KEY=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Email (Resend, etc.)
RESEND_API_KEY=
EMAIL_FROM=

# Optional server-side Sentry (Convex Node actions)
SENTRY_DSN=
