# Env tiers for fellows: docs/fellow-day-0.md
# Also set server secrets in the Convex dashboard for actions/webhooks.
# Tier A = boot · B = money · C = AI · D = product ops · E = job-specific

# --- Tier A: boot the app ---
# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Clerk JWT issuer for Convex (https://xxx.clerk.accounts.dev) — also used as CLERK_JWT_ISSUER_DOMAIN
CLERK_JWT_ISSUER_DOMAIN=
# Optional alias kept for Convex auth.config compatibility
VITE_CLERK_FRONTEND_API_URL=

# Clerk (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
FRONTEND_URL=http://localhost:3000

# --- Tier B: money (pick from docs/engineering-blueprint.md) ---
# Polar = Shipped reference path (prefer for 80/90)
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
# sandbox | production — defaults to sandbox if unset; must match where POLAR_ACCESS_TOKEN was issued
POLAR_SERVER=sandbox

# Stripe = Port (package only until Convex E2E wired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Autumn credits (component wired; needs keys)
AUTUMN_SECRET_KEY=

# --- Tier C: AI jobs (when golden cases need models) ---
# Prefer OpenRouter for metered vertical (mechanic — not a chat product mandate)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Langfuse (LLM traces — server-side; wired in runMeteredInference)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Tier D: recommended product ops ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-side Sentry (Convex Node actions)
SENTRY_DSN=

# --- Tier E: only when the job needs them ---
# Runtime agent sandbox (provider-specific) — Port until provider wired
SANDBOX_API_KEY=

# Email (Resend, etc.) — Port
RESEND_API_KEY=
EMAIL_FROM=

# Web tools (@studio/web-tools + convex/webTools.ts)
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
